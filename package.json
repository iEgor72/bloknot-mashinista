{
  "name": "bloknot-mashinista",
  "version": "1.2.9",
  "private": true,
  "description": "Блокнот машиниста — учёт смен для локомотивных бригад",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "memory:init": "python tools/agent_memory.py init",
    "memory:preflight": "python tools/agent_memory.py preflight",
    "memory:refresh": "python tools/agent_memory.py refresh",
    "memory:log": "python tools/agent_memory.py log",
    "memory:install-hooks": "python tools/agent_memory.py install-hooks",
    "memory:sync": "python tools/agent_memory.py sync --direction push",
    "storage:backup": "node scripts/storage-maintenance.js backup",
    "storage:check": "node scripts/storage-maintenance.js check",
    "storage:restore": "node scripts/storage-maintenance.js restore",
    "test:server": "node --test \"tests/server/*.test.js\"",
    "maps:download": "node scripts/download-poekhali-maps.mjs",
    "maps:import:android-backup": "python scripts/import-poekhali-android-backup.py",
    "reference:import:tch9": "python scripts/import-tch9-reference.py",
    "speeds:import": "python scripts/import-speed-docs.py",
    "regime:import": "python scripts/import-regime-maps.py",
    "regime:test": "python scripts/import-regime-maps-smoke.py",
    "regime:profile": "python scripts/regime-profile-builder.py",
    "regime:builder:test": "python -m unittest discover -s tests/regime_profile_builder -p \"test_*.py\"",
    "sections:validate": "node scripts/validate-tracker-sections.mjs",
    "sections:test": "node scripts/validate-tracker-sections-smoke.mjs",
    "station-names:test": "node scripts/poekhali-station-names-smoke.mjs",
    "smoke:poekhali-json": "node scripts/poekhali-json-smoke.mjs",
    "smoke:sw-update": "node scripts/sw-update-smoke.mjs",
    "smoke:local": "node scripts/local-smoke.mjs",
    "smoke:offline": "node scripts/offline-smoke.mjs",
    "smoke:predeploy": "npm run test:server && npm run regime:test && npm run regime:builder:test && npm run sections:validate && npm run sections:test && npm run station-names:test && npm run smoke:sw-update && npm run smoke:poekhali-json && npm run smoke:local && npm run smoke:offline",
    "smoke:prod-cache": "node scripts/prod-cache-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1"
  }
}
